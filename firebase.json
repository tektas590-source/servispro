{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/api/iyzico/callback", "function": { "functionId": "iyzicoCallback", "region": "europe-west1" } },
      { "source": "/api/iyzico/webhook", "function": { "functionId": "iyzicoWebhook", "region": "europe-west1" } }
    ],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
